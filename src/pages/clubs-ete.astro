---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
---

<Layout title="Clubs d'été - Openmind Academy" description="Clubs d'été Openmind Academy à Sousse.">
  <main class="placeholder-page">
    <div class="container placeholder-content reveal">
      <Icon name="sparkles" size={34} class="placeholder-icon" />
      <p class="eyebrow">Clubs d'été</p>
      <h1>Contenu bientôt disponible</h1>
    </div>
  </main>
</Layout>

<style>
  .placeholder-page {
    padding-top: 78px;
    min-height: 70vh;
    display: flex;
    align-items: center;
    background: linear-gradient(180deg, var(--color-cyan-pale) 0%, var(--color-paper) 60%);
  }
  .placeholder-content {
    text-align: center;
    max-width: 480px;
    margin: 0 auto;
    padding: 60px 20px;
  }
  :global(.placeholder-icon) {
    color: var(--color-cyan);
    margin: 0 auto 18px;
  }
  .placeholder-content h1 {
    font-size: 1.7rem;
    color: var(--color-blue-deep);
  }
</style>
