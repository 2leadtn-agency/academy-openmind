---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
---

<Layout title="À propos - Openmind Academy" description="À propos d'Openmind Academy, centre éducatif pour enfants à Sousse.">
  <main class="placeholder-page">
    <div class="container placeholder-content">
      <Icon name="heart" size={34} class="placeholder-icon" />
      <p class="eyebrow">À propos</p>
      <h1>Contenu bientôt disponible</h1>
    </div>
  </main>
</Layout>

<style>
  .placeholder-page {
    padding-top: 78px;
    min-height: 70vh;
    display: flex;
    align-items: center;
    background: linear-gradient(180deg, var(--color-cyan-pale) 0%, var(--color-paper) 60%);
  }
  .placeholder-content {
    text-align: center;
    max-width: 480px;
    margin: 0 auto;
    padding: 60px 20px;
  }
  .placeholder-icon {
    color: var(--color-spark-deep);
    margin: 0 auto 18px;
  }
  .placeholder-content h1 {
    font-size: 1.7rem;
    color: var(--color-blue-deep);
  }
</style>
