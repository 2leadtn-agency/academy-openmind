---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";

const WHATSAPP_NUMBER = "21699109693";
const WHATSAPP_MESSAGE = encodeURIComponent("Bonjour, je vous contacte depuis votre site");
---

<Layout>
  <main>
    <!-- HERO — asymmetric, collage signature moment -->
    <section class="hero">
      <div class="container hero-grid">
        <div class="hero-copy">
          <p class="eyebrow reveal">Centre éducatif · Sidi Abdelhamid, Sousse</p>
          <h1 class="reveal reveal-delay-1">Là où la curiosité de votre enfant<br /> devient un jeu d'enfant.</h1>
          <p class="hero-lead reveal reveal-delay-2">
            Soutien scolaire, clubs d'été, mémorisation du Coran et cours de langues :
            Openmind Academy accompagne vos enfants dans un cadre bienveillant, vivant
            et sécurisant, au cœur de Sousse.
          </p>
          <div class="hero-actions reveal reveal-delay-3">
            <a
              href={`https://wa.me/${WHATSAPP_NUMBER}?text=${WHATSAPP_MESSAGE}`}
              class="btn btn-whatsapp"
              target="_blank"
              rel="noopener noreferrer"
            >
              <Icon name="whatsapp" size={18} />
              Inscrire mon enfant
            </a>
            <a href="#programmes" class="btn btn-outline">Découvrir nos programmes</a>
          </div>

          <ul class="hero-chips reveal reveal-delay-3">
            <li><Icon name="book-open" size={15} /> Mémorisation du Coran</li>
            <li><Icon name="palette" size={15} /> Clubs d'été</li>
            <li><Icon name="languages" size={15} /> Langues</li>
            <li><Icon name="sparkles" size={15} /> Soutien scolaire</li>
          </ul>
        </div>

        <div class="hero-visual">
          <div class="hero-photo-main">
            <img src="/images/hero-enfants-activites-creatives.jpg" alt="Enfants épanouis lors d'une activité créative à Openmind Academy" data-parallax="14" />
          </div>
          <div class="hero-photo-badge hero-photo-badge-1">
            <img src="/images/hero-badge-musique.jpg" alt="Club de musique pour enfants" />
          </div>
          <div class="hero-photo-badge hero-photo-badge-2">
            <img src="/images/hero-badge-lecture.jpg" alt="Club de lecture intelligente" />
          </div>
          <div class="hero-sticker">
            <span>Places limitées</span>
            <strong>Été 2026</strong>
          </div>
        </div>
      </div>
    </section>

    <!-- TRUST MARQUEE — breaks card rhythm with a moving strip -->
    <div class="marquee">
      <div class="marquee-track">
        <span>Encadrement bienveillant</span>
        <Icon name="star" size={14} />
        <span>Groupes à taille humaine</span>
        <Icon name="star" size={14} />
        <span>Professeurs qualifiés</span>
        <Icon name="star" size={14} />
        <span>Environnement rassurant</span>
        <Icon name="star" size={14} />
        <span>Au cœur de Sidi Abdelhamid</span>
        <Icon name="star" size={14} />
        <span>Encadrement bienveillant</span>
        <Icon name="star" size={14} />
        <span>Groupes à taille humaine</span>
        <Icon name="star" size={14} />
        <span>Professeurs qualifiés</span>
        <Icon name="star" size={14} />
        <span>Environnement rassurant</span>
        <Icon name="star" size={14} />
        <span>Au cœur de Sidi Abdelhamid</span>
        <Icon name="star" size={14} />
      </div>
    </div>

    <!-- PROGRAMS OVERVIEW — bento, not uniform cards -->
    <section class="section programmes" id="programmes">
      <div class="container">
        <p class="eyebrow reveal">Nos programmes</p>
        <h2 class="section-title reveal">Un programme pour chaque enfant, chaque passion.</h2>
        <p class="section-subtitle reveal">
          Du soutien scolaire quotidien aux clubs d'éveil de l'été, chaque parcours est pensé
          pour faire grandir la confiance et la curiosité.
        </p>

        <div class="bento">
          <a href="/clubs-ete" class="bento-tile bento-tile-large reveal">
            <img src="/images/programme-bento-clubs-ete.jpg" alt="Clubs d'été à Openmind Academy" data-parallax="16" />
            <div class="bento-tile-overlay">
              <span class="bento-tag">Été 2026</span>
              <h3>Clubs d'été</h3>
              <p>Musique, danse, lecture intelligente, dessin, langues et activités récréatives — du lundi au samedi.</p>
              <span class="bento-link">Voir le programme estival <Icon name="arrow-right" size={16} /></span>
            </div>
          </a>

          <a href="/programme-coran" class="bento-tile bento-tile-quran reveal reveal-delay-1">
            <div class="bento-quran-pattern" aria-hidden="true"></div>
            <div class="bento-tile-content">
              <span class="bento-tag bento-tag-quran">نحفظ القرآن الكريم</span>
              <h3>Programme Coran</h3>
              <p>2 séances par semaine, sous la supervision d'un enseignant dédié.</p>
              <span class="bento-link bento-link-quran">Découvrir le programme <Icon name="arrow-right" size={16} /></span>
            </div>
          </a>

          <div class="bento-tile bento-tile-medium reveal reveal-delay-2">
            <div class="bento-tile-content">
              <Icon name="sparkles" size={26} class="bento-icon" />
              <h3>UpOnMind</h3>
              <p>Séances de sensibilisation et d'accompagnement, et sessions de révision pour l'excellence académique.</p>
            </div>
          </div>

          <div class="bento-tile bento-tile-medium reveal reveal-delay-3">
            <div class="bento-tile-content">
              <Icon name="book-open" size={26} class="bento-icon" />
              <h3>Club Lecture & Dessin</h3>
              <p>Séances de contes et ateliers de dessin, avec une séance de Coran libre et gratuite le dimanche.</p>
            </div>
          </div>

          <div class="bento-tile bento-tile-medium reveal">
            <div class="bento-tile-content">
              <Icon name="languages" size={26} class="bento-icon" />
              <h3>Langues</h3>
              <p>Cours de perfectionnement en arabe, français et anglais, à tous les niveaux.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- SIGNATURE PHOTO BAND — full-bleed divider -->
    <section class="signature-band reveal">
      <img src="/images/bande-signature-vie-academie.jpg" alt="La vie à Openmind Academy" data-parallax="30" />
      <div class="signature-band-caption">
        <p>Un lieu où apprendre rime avec s'amuser.</p>
      </div>
    </section>

    <!-- SUMMER PROGRAM SCHEDULE -->
    <section class="section estival">
      <div class="container">
        <div class="estival-head">
          <div>
            <p class="eyebrow reveal">Programme estival</p>
            <h2 class="section-title reveal">Deux formules, du lundi au samedi.</h2>
            <p class="section-subtitle reveal">Choisissez la session qui convient le mieux au rythme de votre enfant.</p>
          </div>
          <a href="/clubs-ete" class="btn btn-blue reveal">Voir les clubs d'été</a>
        </div>

        <div class="estival-sessions">
          <div class="estival-card reveal">
            <Icon name="sun" size={30} class="estival-icon" />
            <h3>Séance du matin</h3>
            <p class="estival-time">8h00 — 14h00</p>
            <p>Idéale pour un démarrage tôt et des après-midis libres en famille.</p>
          </div>
          <div class="estival-card reveal reveal-delay-1">
            <Icon name="moon-star" size={30} class="estival-icon" />
            <h3>Séance de l'après-midi</h3>
            <p class="estival-time">13h00 — 19h00</p>
            <p>Parfaite pour les matinées tranquilles et une fin de journée active.</p>
          </div>
        </div>
        <p class="estival-note reveal"><Icon name="calendar" size={16} /> Du lundi au samedi, toute la durée de l'été.</p>
      </div>
    </section>

    <!-- QURAN PROGRAM — deliberately distinct world -->
    <section class="quran-section">
      <img class="quran-bg-photo" src="/images/motif-geometrique-vert-dore.jpg" alt="" aria-hidden="true" />
      <div class="quran-overlay" aria-hidden="true"></div>
      <div class="quran-pattern" aria-hidden="true"></div>
      <div class="container quran-grid">
        <div class="quran-copy reveal">
          <p class="eyebrow is-quran">Programme dédié</p>
          <p class="quran-arabic">نحفظ القرآن الكريم</p>
          <h2 class="quran-title">Mémorisation du Coran</h2>
          <p>
            Deux séances par semaine, encadrées par un enseignant dédié, dans un cadre
            serein, respectueux et adapté au rythme de chaque enfant.
          </p>
          <a href="/programme-coran" class="btn btn-green">Découvrir le programme</a>
        </div>
        <div class="quran-mark reveal reveal-delay-1" aria-hidden="true">
          <Icon name="book-open" size={64} />
        </div>
      </div>
    </section>

    <!-- READING & DRAWING CLUB -->
    <section class="section lecture-dessin">
      <div class="container lecture-dessin-grid">
        <div class="lecture-dessin-photo reveal">
          <img src="/images/photo-club-lecture-dessin.jpg" alt="Club Lecture et Dessin" />
        </div>
        <div class="reveal reveal-delay-1">
          <p class="eyebrow">Club Lecture & Dessin</p>
          <h2 class="section-title">Des histoires qui font voyager l'imagination.</h2>
          <p class="section-subtitle">
            Chaque semaine, nos séances de contes éveillent la curiosité des enfants,
            prolongées par des ateliers de dessin où ils expriment ce qu'ils imaginent.
            Le dimanche, une séance de Coran libre et gratuite vient compléter la semaine.
          </p>
          <ul class="lecture-dessin-list">
            <li><Icon name="check-circle" size={18} /> Séances de contes hebdomadaires</li>
            <li><Icon name="check-circle" size={18} /> Ateliers de dessin et créativité</li>
            <li><Icon name="check-circle" size={18} /> Séance de Coran libre le dimanche, gratuite</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- TRUST STAT STRIP -->
    <section class="stat-strip">
      <div class="container stat-strip-grid">
        <div class="stat-item reveal">
          <Icon name="users" size={26} />
          <span>Groupes à taille humaine</span>
        </div>
        <div class="stat-item reveal reveal-delay-1">
          <Icon name="heart" size={26} />
          <span>Encadrement bienveillant</span>
        </div>
        <div class="stat-item reveal reveal-delay-2">
          <Icon name="graduation-cap" size={26} />
          <span>Professeurs qualifiés</span>
        </div>
        <div class="stat-item reveal reveal-delay-3">
          <Icon name="map-pin" size={26} />
          <span>Au cœur de Sidi Abdelhamid</span>
        </div>
      </div>
    </section>

    <!-- FINAL CTA -->
    <section class="final-cta">
      <div class="container final-cta-inner">
        <div class="reveal">
          <h2>Prêt à inscrire votre enfant ?</h2>
          <p>Écrivez-nous dès aujourd'hui, nous répondons avec plaisir à toutes vos questions.</p>
        </div>
        <div class="final-cta-actions reveal reveal-delay-1">
          <a
            href={`https://wa.me/${WHATSAPP_NUMBER}?text=${WHATSAPP_MESSAGE}`}
            class="btn btn-whatsapp"
            target="_blank"
            rel="noopener noreferrer"
          >
            <Icon name="whatsapp" size={18} /> WhatsApp
          </a>
          <a href="/contact" class="btn btn-outline-light">Nous contacter</a>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  main {
    padding-top: 78px;
  }

  /* ---------- HERO ---------- */
  .hero {
    padding: 40px 0 60px;
    background: linear-gradient(180deg, var(--color-cyan-pale) 0%, var(--color-paper) 68%);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    align-items: center;
  }

  .hero-copy h1 {
    font-size: 2.1rem;
    margin: 16px 0 18px;
    letter-spacing: -0.01em;
  }

  .hero-lead {
    font-size: 1.02rem;
    color: var(--color-ink-soft);
    max-width: 480px;
    margin-bottom: 26px;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 26px;
  }

  .hero-chips {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .hero-chips li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: #fff;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    padding: 8px 14px;
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--color-blue-deep);
    box-shadow: 0 4px 12px rgba(11, 47, 160, 0.06);
  }
  .hero-chips :global(.icon) { color: var(--color-cyan); }

  .hero-visual {
    position: relative;
    max-width: 420px;
    margin: 0 auto;
    padding: 10px 30px 40px 0;
  }

  .hero-photo-main {
    border-radius: 46% 54% 61% 39% / 45% 40% 60% 55%;
    overflow: hidden;
    box-shadow: var(--shadow-soft);
    aspect-ratio: 1 / 1.12;
  }
  .hero-photo-main img {
    width: 118%;
    height: 118%;
    max-width: 118%;
    object-fit: cover;
    margin-left: -9%;
    margin-top: -9%;
  }

  .hero-photo-badge {
    position: absolute;
    width: 96px;
    height: 96px;
    border-radius: 50%;
    overflow: hidden;
    border: 4px solid var(--color-paper);
    box-shadow: 0 10px 22px rgba(11, 47, 160, 0.22);
  }
  .hero-photo-badge img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-photo-badge-1 {
    top: -6px;
    right: 6px;
    animation: float-badge 3.6s ease-in-out infinite;
  }
  .hero-photo-badge-2 {
    bottom: 18px;
    left: -14px;
    width: 78px;
    height: 78px;
    animation: float-badge 4.2s ease-in-out infinite;
    animation-delay: 0.6s;
  }

  @keyframes float-badge {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-7px); }
  }
  @keyframes float-sticker {
    0%, 100% { transform: rotate(-6deg) translateY(0); }
    50% { transform: rotate(-6deg) translateY(-6px); }
  }

  .hero-sticker {
    position: absolute;
    bottom: -6px;
    right: 20px;
    background: var(--color-spark);
    color: var(--color-blue-deep);
    border-radius: 16px;
    padding: 10px 16px;
    box-shadow: var(--shadow-punch);
    display: flex;
    flex-direction: column;
    line-height: 1.2;
    animation: float-sticker 3.9s ease-in-out infinite;
    animation-delay: 0.3s;
  }
  .hero-sticker span {
    font-size: 0.68rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .hero-sticker strong {
    font-family: var(--font-display);
    font-size: 1rem;
  }

  /* ---------- MARQUEE ---------- */
  .marquee {
    background: var(--color-blue);
    overflow: hidden;
    padding: 14px 0;
  }
  .marquee-track {
    display: flex;
    align-items: center;
    gap: 14px;
    white-space: nowrap;
    width: max-content;
    animation: marquee 26s linear infinite;
    color: #fff;
    font-weight: 500;
    font-size: 0.9rem;
  }
  .marquee-track :global(.icon) {
    color: var(--color-spark);
  }
  @keyframes marquee {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-track { animation: none; }
  }

  /* ---------- BENTO ---------- */
  .bento {
    margin-top: 36px;
    display: grid;
    grid-template-columns: 1fr;
    gap: 18px;
  }

  .bento-tile {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    display: block;
    min-height: 220px;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  a.bento-tile:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-soft);
  }

  .bento-tile-large {
    min-height: 300px;
  }
  .bento-tile-large img {
    position: absolute;
    top: -15%;
    left: 0;
    width: 100%;
    height: 130%;
    object-fit: cover;
  }
  .bento-tile-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(7, 29, 99, 0.15) 0%, rgba(7, 29, 99, 0.86) 100%);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 28px;
    color: #fff;
  }
  .bento-tag {
    align-self: flex-start;
    background: var(--color-spark);
    color: var(--color-blue-deep);
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 600;
    padding: 5px 12px;
    border-radius: 999px;
    margin-bottom: 12px;
  }
  .bento-tile-overlay h3 {
    color: #fff;
    font-size: 1.5rem;
    margin-bottom: 8px;
  }
  .bento-tile-overlay p {
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.85);
    max-width: 340px;
    margin-bottom: 14px;
  }
  .bento-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.86rem;
    color: var(--color-spark);
  }

  .bento-tile-medium {
    background: #fff;
    border: 1px solid var(--color-line);
    min-height: 200px;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .bento-tile-medium:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-soft);
  }
  .bento-tile-content {
    padding: 26px;
    height: 100%;
    display: flex;
    flex-direction: column;
  }
  :global(.bento-icon) {
    color: var(--color-cyan);
    margin-bottom: 14px;
    transition: transform 0.3s ease;
  }
  .bento-tile-medium:hover :global(.bento-icon) {
    transform: translateY(-2px) rotate(-8deg);
  }
  .bento-tile-content h3 {
    font-size: 1.15rem;
    margin-bottom: 8px;
  }
  .bento-tile-content p {
    font-size: 0.9rem;
    color: var(--color-ink-soft);
  }

  .bento-tile-quran {
    background: var(--color-quran-green-deep);
    color: #fff;
  }
  .bento-quran-pattern {
    position: absolute;
    inset: 0;
    opacity: 0.5;
    background-image: radial-gradient(circle at 20% 20%, rgba(255,255,255,0.08) 0, rgba(255,255,255,0.08) 2px, transparent 2px),
      radial-gradient(circle at 60% 70%, rgba(255,255,255,0.06) 0, rgba(255,255,255,0.06) 2px, transparent 2px);
    background-size: 34px 34px, 46px 46px;
  }
  .bento-tile-quran .bento-tile-content {
    position: relative;
  }
  .bento-tag-quran {
    background: rgba(255, 255, 255, 0.14);
    color: #fff;
    font-size: 0.95rem;
  }
  .bento-tile-quran h3 { color: #fff; }
  .bento-tile-quran p { color: rgba(255, 255, 255, 0.78); }
  .bento-link-quran { color: #a7d9b6; }

  /* ---------- SIGNATURE BAND ---------- */
  .signature-band {
    position: relative;
    width: 100%;
    height: 260px;
    overflow: hidden;
  }
  .signature-band img {
    position: absolute;
    top: -15%;
    left: 0;
    width: 100%;
    height: 130%;
    object-fit: cover;
  }
  .signature-band-caption {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(120deg, rgba(7, 29, 99, 0.55) 0%, rgba(11, 47, 160, 0.15) 55%, rgba(7, 29, 99, 0.55) 100%);
  }
  .signature-band-caption p {
    font-family: var(--font-display);
    font-size: 1.4rem;
    color: #fff;
    text-align: center;
    padding: 0 24px;
    max-width: 560px;
  }

  /* ---------- ESTIVAL ---------- */
  .estival-head {
    display: flex;
    flex-direction: column;
    gap: 20px;
    align-items: flex-start;
    margin-bottom: 30px;
  }
  .estival-sessions {
    display: grid;
    grid-template-columns: 1fr;
    gap: 18px;
  }
  .estival-card {
    background: #fff;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    padding: 28px;
  }
  :global(.estival-icon) {
    color: var(--color-spark-deep);
    margin-bottom: 12px;
  }
  .estival-card h3 {
    font-size: 1.2rem;
    margin-bottom: 6px;
  }
  .estival-time {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--color-blue);
    font-size: 1.1rem;
    margin-bottom: 10px;
  }
  .estival-card p:last-child {
    color: var(--color-ink-soft);
    font-size: 0.92rem;
  }
  .estival-note {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 22px;
    color: var(--color-ink-soft);
    font-size: 0.9rem;
  }
  .estival-note :global(.icon) { color: var(--color-cyan); }

  /* ---------- QURAN SECTION (distinct world) ---------- */
  .quran-section {
    position: relative;
    background: var(--color-quran-green-deep);
    padding: 64px 0;
    overflow: hidden;
  }
  .quran-bg-photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.8;
    filter: saturate(0.9);
  }
  .quran-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(160deg, rgba(9, 46, 25, 0.72) 0%, rgba(16, 68, 37, 0.6) 55%, rgba(9, 46, 25, 0.8) 100%);
  }
  .quran-pattern {
    position: absolute;
    inset: 0;
    background-image: repeating-linear-gradient(45deg, rgba(255,255,255,0.035) 0 2px, transparent 2px 26px),
      repeating-linear-gradient(-45deg, rgba(255,255,255,0.035) 0 2px, transparent 2px 26px);
  }
  .quran-grid {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    gap: 30px;
    align-items: center;
  }
  .quran-arabic {
    font-size: 1.6rem;
    color: #dff2e3;
    margin: 10px 0 6px;
    line-height: 1.6;
  }
  .quran-title {
