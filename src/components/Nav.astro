---
import Icon from "./Icon.astro";

const PHONE_DISPLAY = "99 109 693";
const PHONE_TEL = "+21699109693";
const WHATSAPP_NUMBER = "21699109693";
const WHATSAPP_MESSAGE = encodeURIComponent("Bonjour, je vous contacte depuis votre site");

const navLinks = [
  { href: "/", label: "Accueil" },
  { href: "/clubs-ete", label: "Clubs d'été" },
  { href: "/programme-coran", label: "Programme Coran" },
  { href: "/a-propos", label: "À propos" },
  { href: "/contact", label: "Contact" },
];

const currentPath = Astro.url.pathname;
---

<header class="nav" id="site-nav">
  <div class="container nav-inner">
    <a href="/" class="nav-logo" aria-label="Openmind Academy - Accueil">
      <img src="/images/logo.png" alt="Openmind Academy" width="44" height="44" />
      <span class="nav-logo-text">Openmind<span>Academy</span></span>
    </a>

    <nav class="nav-links" aria-label="Navigation principale">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class={`nav-link ${currentPath === link.href ? "is-active" : ""}`}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="nav-actions">
      <a href={`tel:${PHONE_TEL}`} class="nav-icon-btn" aria-label="Appeler Openmind Academy">
        <Icon name="phone" size={18} />
      </a>
      <a
        href={`https://wa.me/${WHATSAPP_NUMBER}?text=${WHATSAPP_MESSAGE}`}
        class="nav-icon-btn nav-whatsapp"
        aria-label="Écrire sur WhatsApp"
        target="_blank"
        rel="noopener noreferrer"
      >
        <Icon name="whatsapp" size={18} />
      </a>
      <a href="/contact" class="btn btn-spark nav-cta">Inscrire mon enfant</a>

      <button class="nav-burger" id="nav-burger" aria-label="Ouvrir le menu" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <svg class="nav-wave" viewBox="0 0 400 12" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0 4 C 50 12, 100 0, 150 5 S 250 12, 300 4 S 370 0, 400 5" />
  </svg>

  <div class="nav-mobile" id="nav-mobile">
    {navLinks.map((link) => (
      <a href={link.href} class="nav-mobile-link">{link.label}</a>
    ))}
    <a href="/contact" class="btn btn-spark nav-mobile-cta">Inscrire mon enfant</a>
    <a href={`tel:${PHONE_TEL}`} class="nav-mobile-phone">{PHONE_DISPLAY}</a>
  </div>
</header>

<script is:inline>
  (function () {
    var nav = document.getElementById("site-nav");
    var burger = document.getElementById("nav-burger");
    var mobile = document.getElementById("nav-mobile");
    if (!nav) return;

    function onScroll() {
      if (window.scrollY > 8) {
        nav.classList.add("nav-scrolled");
      } else {
        nav.classList.remove("nav-scrolled");
      }
    }
    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();

    if (burger && mobile) {
      burger.addEventListener("click", function () {
        var isOpen = mobile.classList.toggle("open");
        burger.classList.toggle("open", isOpen);
        burger.setAttribute("aria-expanded", String(isOpen));
        document.body.style.overflow = isOpen ? "hidden" : "";
      });
    }
  })();
</script>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    background: rgba(255, 250, 242, 0.92);
    backdrop-filter: blur(10px);
    transition: box-shadow 0.2s ease;
  }

  .nav-scrolled {
    box-shadow: 0 6px 24px rgba(11, 47, 160, 0.1);
  }

  .nav-wave {
    display: block;
    width: 100%;
    height: 6px;
    color: var(--color-cyan);
    opacity: 0.55;
  }
  .nav-wave path {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 72px;
    gap: 12px;
  }

  .nav-logo {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
    text-decoration: none;
  }

  .nav-logo img {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    object-fit: contain;
  }

  .nav-logo-text {
    display: none;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.05rem;
    color: var(--color-blue-deep);
    line-height: 1.05;
  }
  .nav-logo-text span {
    display: block;
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-cyan);
  }

  .nav-links {
    display: none;
  }

  .nav-link {
    text-decoration: none;
    font-weight: 500;
    font-size: 0.95rem;
    color: var(--color-ink-soft);
    transition: color 0.15s ease;
    position: relative;
    padding-bottom: 2px;
  }

  .nav-link::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -4px;
    width: 0;
    height: 3px;
    border-radius: 3px;
    background: var(--color-spark);
    transition: width 0.2s ease;
  }

  .nav-link:hover,
  .nav-link.is-active {
    color: var(--color-blue-deep);
  }

  .nav-link:hover::after,
  .nav-link.is-active::after {
    width: 100%;
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .nav-icon-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: var(--color-cyan-pale);
    color: var(--color-blue);
    text-decoration: none;
    flex-shrink: 0;
    transition: transform 0.15s ease;
  }

  .nav-whatsapp {
    background: #e6faec;
    color: #1fa855;
  }

  .nav-icon-btn:hover {
    transform: translateY(-2px);
  }

  .nav-cta {
    display: none;
    padding: 11px 20px;
    font-size: 0.86rem;
  }

  .nav-burger {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    border: none;
    background: var(--color-cyan-pale);
    cursor: pointer;
    flex-shrink: 0;
  }

  .nav-burger span {
    display: block;
    width: 18px;
    height: 2px;
    background: var(--color-blue-deep);
    border-radius: 2px;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .nav-burger.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .nav-burger.open span:nth-child(2) { opacity: 0; }
  .nav-burger.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  .nav-mobile {
    max-height: 0;
    overflow: hidden;
    background: var(--color-paper);
    border-top: 1px solid var(--color-line);
    transition: max-height 0.28s ease;
    display: flex;
    flex-direction: column;
  }

  .nav-mobile.open {
    max-height: 460px;
  }

  .nav-mobile-link {
    text-decoration: none;
    font-weight: 500;
    font-size: 1rem;
    color: var(--color-ink);
    padding: 16px 20px;
    border-bottom: 1px solid var(--color-line);
  }

  .nav-mobile-cta {
    margin: 16px 20px 8px;
  }

  .nav-mobile-phone {
    text-align: center;
    text-decoration: none;
    font-weight: 600;
    color: var(--color-blue);
    padding: 0 20px 20px;
    font-family: var(--font-display);
  }

  @media (min-width: 640px) {
    .nav-cta { display: inline-flex; }
    .nav-logo-text { display: block; }
  }

  @media (min-width: 960px) {
    .nav-inner { height: 84px; }
    .nav-links {
      display: flex;
      align-items: center;
      gap: 26px;
    }
    .nav-burger, .nav-mobile { display: none; }
  }
</style>
