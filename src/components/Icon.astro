---
// Minimalist outline icon set (Lucide/Feather-style: 1.6px stroke, no fill, round joins).
// Business-specific glyphs (book-open, music-note, palette, languages, sparkles, sun, moon-star)
// are hand-built in the same stroke language since no single open-source icon fits exactly.
interface Props {
  name: string;
  size?: number;
  strokeWidth?: number;
  class?: string;
}

const { name, size = 22, strokeWidth = 1.6, class: className = "" } = Astro.props;

const paths: Record<string, string> = {
  phone:
    '<path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.5 21 3 13.5 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.4 0 .8-.2 1L6.6 10.8z"/>',
  mail:
    '<rect x="3" y="5" width="18" height="14" rx="2.4"/><path d="m3.5 6.5 8.5 6 8.5-6"/>',
  "map-pin":
    '<path d="M12 21.5s7-6.3 7-12A7 7 0 0 0 5 9.5c0 5.7 7 12 7 12z"/><circle cx="12" cy="9.5" r="2.4"/>',
  menu: '<path d="M3.5 6.5h17M3.5 12h17M3.5 17.5h17"/>',
  x: '<path d="m5 5 14 14M19 5 5 19"/>',
  "chevron-right": '<path d="m9 5 7 7-7 7"/>',
  "arrow-right": '<path d="M4 12h16M13 5l7 7-7 7"/>',
  star:
    '<path d="m12 2.5 2.9 6.2 6.6.8-4.9 4.6 1.3 6.6L12 17.6l-5.9 3.1 1.3-6.6-4.9-4.6 6.6-.8L12 2.5z"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5.5l3.5 2"/>',
  calendar:
    '<rect x="3.5" y="5" width="17" height="16" rx="2.2"/><path d="M8 3v4M16 3v4M3.5 10h17"/>',
  users:
    '<circle cx="9" cy="8.5" r="3.3"/><path d="M2.7 20c.8-3.4 3.3-5.3 6.3-5.3s5.5 1.9 6.3 5.3"/><path d="M16.3 5.6a3.3 3.3 0 0 1 0 6.4M21.3 20c-.6-2.6-2-4.3-4-5"/>',
  check: '<path d="M4.5 12.5 9.5 17.5 19.5 6.5"/>',
  "check-circle": '<circle cx="12" cy="12" r="9"/><path d="m8 12.5 2.6 2.6L16.5 9"/>',
  heart:
    '<path d="M12 20.2s-7.8-4.7-10-9.7C.4 6.8 2.7 3.5 6.3 3.5c2.1 0 3.7 1.1 4.7 2.6.9-1.4 2.6-2.6 4.7-2.6 3.6 0 5.9 3.3 4.3 7-2.2 5-10 9.7-10 9.7z"/>',
  "message-circle":
    '<path d="M3 12.3C3 7.2 7.3 3 12.5 3S22 7.2 22 12.3s-4.3 9.3-9.5 9.3c-1.3 0-2.6-.3-3.7-.8L3 22l1.4-4.6C3.5 15.9 3 14.2 3 12.3z"/>',
  send: '<path d="M21 3 3 10.5l7.5 3M21 3l-3.5 18-7-7.5M21 3l-10.5 10.5"/>',
  facebook:
    '<path d="M14.5 21v-7.8h2.6l.4-3h-3v-1.9c0-.9.2-1.5 1.5-1.5h1.6V4.1c-.3 0-1.2-.1-2.3-.1-2.3 0-3.9 1.4-3.9 4v2.2H8.8v3H11V21h3.5z"/>',
  "book-open":
    '<path d="M12 6.2c-1.6-1.3-3.8-1.9-6.5-1.9-.6 0-1 .4-1 1v11.8c0 .6.4 1 1 1 2.7 0 4.9.6 6.5 1.9 1.6-1.3 3.8-1.9 6.5-1.9.6 0 1-.4 1-1V5.3c0-.6-.4-1-1-1-2.7 0-4.9.6-6.5 1.9z"/><path d="M12 6.2V19"/>',
  "music-note":
    '<path d="M9 18.5a2.5 2.5 0 1 1 0-5 2.5 2.5 0 0 1 0 5z"/><path d="M11.5 13.5V4.8l7-1.6v9.2"/><path d="M18.5 12.4a2.5 2.5 0 1 1 0-5 2.5 2.5 0 0 1 0 5z"/>',
  palette:
    '<path d="M12 3.5c-4.7 0-8.5 3.6-8.5 8.1 0 3.6 2.9 5.2 5 5.2.7 0 1-.4 1-.9 0-.5-.4-.8-.4-1.4 0-.6.5-1 1.2-1H12c3.6 0 6.5-2.6 6.5-6 0-2.2-2.6-4-6.5-4z"/><circle cx="8" cy="10.3" r=".9"/><circle cx="11.2" cy="7.6" r=".9"/><circle cx="14.8" cy="7.9" r=".9"/><circle cx="16.6" cy="11" r=".9"/>',
  languages:
    '<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.4 2.5 3.7 5.7 3.7 9s-1.3 6.5-3.7 9c-2.4-2.5-3.7-5.7-3.7-9S9.6 5.5 12 3z"/>',
  sparkles:
    '<path d="M11.5 3.5c.4 2.8 1 4.3 2.1 5.4 1.1 1.1 2.6 1.7 5.4 2.1-2.8.4-4.3 1-5.4 2.1-1.1 1.1-1.7 2.6-2.1 5.4-.4-2.8-1-4.3-2.1-5.4-1.1-1.1-2.6-1.7-5.4-2.1 2.8-.4 4.3-1 5.4-2.1 1.1-1.1 1.7-2.6 2.1-5.4z"/><path d="M18.5 15.8c.2 1.2.5 1.9.9 2.3.4.4 1.1.7 2.3.9-1.2.2-1.9.5-2.3.9-.4.4-.7 1.1-.9 2.3-.2-1.2-.5-1.9-.9-2.3-.4-.4-1.1-.7-2.3-.9 1.2-.2 1.9-.5 2.3-.9.4-.4.7-1.1.9-2.3z"/>',
  sun: '<circle cx="12" cy="12" r="4.2"/><path d="M12 2.5v2.3M12 19.2v2.3M4.6 4.6l1.6 1.6M17.8 17.8l1.6 1.6M2.5 12h2.3M19.2 12h2.3M4.6 19.4l1.6-1.6M17.8 6.2l1.6-1.6"/>',
  "moon-star":
    '<path d="M18 5.5a6.8 6.8 0 1 0 0 13.4 7.6 7.6 0 0 1-4.8-7.1c0-2.9 1.7-5.4 4.8-6.3z"/><path d="M20.5 2.5l.5 1.4 1.4.5-1.4.5-.5 1.4-.5-1.4-1.4-.5 1.4-.5z"/>',
  "graduation-cap":
    '<path d="M2 9.5 12 5l10 4.5-10 4.5-10-4.5z"/><path d="M6 11.7v4.3c0 1.4 2.7 2.5 6 2.5s6-1.1 6-2.5v-4.3M20.5 9.5v6"/>',
  quote:
    '<path d="M8.5 8.5c-2.5 0-4 2-4 4.4 0 2.2 1.6 3.9 3.7 3.9.3 1.7-.9 3.2-2.7 3.7l.4 1.3c3-.7 5-2.8 5-6.2 0-3.6-1.2-7.1-2.4-7.1zM17 8.5c-2.5 0-4 2-4 4.4 0 2.2 1.6 3.9 3.7 3.9.3 1.7-.9 3.2-2.7 3.7l.4 1.3c3-.7 5-2.8 5-6.2 0-3.6-1.2-7.1-2.4-7.1z"/>',
};

// WhatsApp is a filled two-tone brand mark, not a stroke glyph — it can't go
// through the generic outline renderer below, so it gets its own markup.
const isWhatsapp = name === "whatsapp";
const svg = paths[name] ?? "";
---

{isWhatsapp && (
  <svg
    class={`icon ${className}`}
    width={size}
    height={size}
    viewBox="0 0 32 32"
    xmlns="http://www.w3.org/2000/svg"
  >
    <path
      d="M16.02 3C9.4 3 4 8.4 4 15.02c0 2.36.64 4.57 1.87 6.52L4 29l7.63-1.83a11.96 11.96 0 0 0 4.4.83h.01c6.62 0 12.02-5.4 12.02-12.02C28.06 8.4 22.66 3 16.02 3z"
      fill="#25D366"
    ></path>
    <path
      d="M22.1 18.6c-.34-.17-2-1-2.3-1.1-.31-.11-.53-.17-.76.17-.22.34-.87 1.1-1.07 1.32-.2.23-.4.25-.73.08-.34-.17-1.43-.53-2.72-1.68-1-.9-1.68-2-1.88-2.34-.2-.34-.02-.52.15-.69.15-.15.34-.4.5-.6.17-.2.22-.34.34-.57.11-.23.06-.43-.03-.6-.08-.17-.76-1.85-1.05-2.53-.27-.66-.55-.57-.76-.58h-.65c-.23 0-.6.08-.91.43-.31.34-1.2 1.17-1.2 2.86s1.23 3.32 1.4 3.55c.17.23 2.42 3.7 5.87 5.19.82.35 1.46.56 1.96.72.82.26 1.57.22 2.16.13.66-.1 2-.82 2.28-1.6.28-.79.28-1.47.2-1.6-.08-.14-.31-.23-.65-.4z"
      fill="#fff"
    ></path>
  </svg>
)}

{!isWhatsapp && svg && (
  <svg
    class={`icon ${className}`}
    width={size}
    height={size}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width={strokeWidth}
    stroke-linecap="round"
    stroke-linejoin="round"
    set:html={svg}
  />
)}
